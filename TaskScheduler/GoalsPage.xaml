<Page x:Class="TaskScheduler.GoalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 
		d:DesignHeight="450" d:DesignWidth="800"
	  Title="GoalsPage"
	  Background="{DynamicResource WindowBackgroundBrush}"
	  Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="237*"/>
            <ColumnDefinition Width="262*" />
            <ColumnDefinition Width="262*" />
            <ColumnDefinition Width="262*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="22*" />
        </Grid.RowDefinitions>

		<!-- Header-->
		<Label Content="Goals " Grid.Column="0" Grid.Row="0" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Medium" Grid.ColumnSpan="2" Margin="0,0,0,40" Grid.RowSpan="2" Foreground="{DynamicResource SecondaryTextBrush}" />
		<Button Content="Add Goal+" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="{DynamicResource SmallFontSize}" Click="Click_AddGoals"/>
        
		<!-- labels -->
		<Label Content="Not Started" Grid.Column="0" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<Label Content="In Progress" Grid.Column="2" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
		<Label Content="On Hold" Grid.Column="3" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
		<Label Content="Completed" Grid.Column="4" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />

        <!-- Not started content-->
        <Grid Margin="10,10,10,10" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
			<DataGrid x:Name="UnstartedGoals" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="UnstartedGoals_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Name" Width ="150*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>

					<!--ProgressBar-->
					<DataGridTemplateColumn Header="Progress" Width="100*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Vertical" Margin="5,5,5,5">
									<ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="{Binding TargetValue}" Height="10"/>
									<TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Unit}"/>
										<TextBlock Text=" finished"/>
									</StackPanel>

								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>

			</DataGrid>
		</Grid>
             
        

        <!-- In Progress Goals -->
        <Grid Margin="10,10,10,10" Grid.Column="2" Grid.Row="2">
			<DataGrid x:Name="InProgressGoals" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="InProgressGoals_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Name" Width ="150*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>

					<!--ProgressBar-->
					<DataGridTemplateColumn Header="Progress" Width="100*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Vertical" Margin="5,5,5,5">
									<ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="{Binding TargetValue}" Height="10"/>
									<TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Unit}"/>
										<TextBlock Text=" finished"/>
									</StackPanel>

								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>

			</DataGrid>
		</Grid>

        <!-- On Hold Goals -->
        <Grid Margin="10,10,10,10" Grid.Column="3" Grid.Row="2">
			<DataGrid x:Name="OnHoldGoals" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnHoldGoals_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Name" Width ="150*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>

					<!--ProgressBar-->
					<DataGridTemplateColumn Header="Progress" Width="100*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Vertical" Margin="5,5,5,5">
									<ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="{Binding TargetValue}" Height="10"/>
									<TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Unit}"/>
										<TextBlock Text=" finished"/>
									</StackPanel>

								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>

			</DataGrid>
		</Grid>
        
        <!-- Completed Goals -->
        <Grid Margin="10,10,10,10" Grid.Column="4" Grid.Row="2">
			<DataGrid x:Name="CompletedGoals" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CompletedGoals_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Name" Width ="150*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>

					<!--ProgressBar-->
					<DataGridTemplateColumn Header="Progress" Width="100*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Vertical" Margin="5,5,5,5">
									<ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="{Binding TargetValue}" Height="10"/>
									<TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Unit}"/>
										<TextBlock Text=" finished"/>
									</StackPanel>

								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>

			</DataGrid>
		</Grid>
    </Grid>
</Page>
