<Page x:Class="TaskScheduler.CategoryDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoryDetailPage">

	<Grid TextBox.TextChanged="OnTextboxTextChanged" Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Content="Category Details" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>

		<Label Content="Category Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtCategoryName" IsReadOnly ="False" Grid.Row="1" Grid.Column="1" Margin="10,5,10,5" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" />

		<Label Content="Category Group:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<ComboBox x:Name="cmbCategoryGroup" Grid.Row="1" Grid.Column="3" DisplayMemberPath="GroupName" SelectedValuePath="GroupID" Margin="10,5,10,5"/>

		<Label Content="Description:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtDescription" IsReadOnly ="False" Grid.Row="2" Grid.Column="1" Margin="10,5,10,5" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
		
		<Label Content="Color:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtColor" IsReadOnly ="False" Grid.Row="2" Grid.Column="3" Margin="10,5,10,5" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

		<Button x:Name="DeleteButton"  Content="Delete"  Grid.Row="9" Grid.Column="0"  Click="DeleteButton_Click"/>
		<Button x:Name="SaveButton"  Content="Save" IsEnabled="False"  Grid.Row="9" Grid.Column="3"  Click="SaveButton_Click"/>

	</Grid>
</Page>
