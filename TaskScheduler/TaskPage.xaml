<Page x:Class="TaskScheduler.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 
		d:DesignHeight="450" d:DesignWidth="800"
	  Title="TaskPage"
	  Background="{DynamicResource WindowBackgroundBrush}"
	  Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="237*"/>
            <ColumnDefinition Width="262*" />
            <ColumnDefinition Width="262*" />
            <ColumnDefinition Width="262*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="22*" />
        </Grid.RowDefinitions>

		<!-- Header-->
		<StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
		<Label x:Name ="userName" Grid.Row="0" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Medium" Grid.ColumnSpan="2" Margin="0,0,0,40" Grid.RowSpan="2" Foreground="{DynamicResource SecondaryTextBrush}" />
		<Label Content="Tasks " Grid.Column="0" Grid.Row="0" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Medium" Grid.ColumnSpan="2" Margin="0,0,0,40" Grid.RowSpan="2" Foreground="{DynamicResource SecondaryTextBrush}" />

		</StackPanel>
		<Button Content="Add Task+" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="{DynamicResource SmallFontSize}" Click="Click_AddTask"/>
		

        <!-- labels -->
		<Label Content="Daily Tasks" Grid.Column="0" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
		<Label Content="Chores" Grid.Column="2" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
		<Label Content="Fun Activities" Grid.Column="3" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
		<Label Content="Completed" Grid.Column="4" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Daily Tasks content-->
		<Grid Margin="10,10,10,10" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
			<DataGrid x:Name="AllDailyTasks" Grid.Row="9" Grid.RowSpan="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="AllDailyTasks_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="#" Width="10*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding TaskID}"/>
					<DataGridTextColumn Header="Name" Width ="60*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>
					<DataGridTextColumn Header="Day" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding PreferredDay}"/>
					<DataGridTextColumn Header="Length" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Duration}"/>
					<DataGridTemplateColumn Header="/">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button x:Name="CompleteButton"  Content="/"  Grid.Row="8" Grid.Column="2" PreviewMouseLeftButtonDown="CompleteButton_PreviewMouseLeftButtonDown" Click="CompleteButton_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>



		<!-- Chores -->
        <Grid Margin="10,10,10,10" Grid.Column="2" Grid.Row="2">
			<DataGrid x:Name="AllChores" Grid.Row="5" Grid.RowSpan="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="AllChores_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="#" Width="10*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding TaskID}"/>
					<DataGridTextColumn Header="Name" Width ="60*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>
					<DataGridTextColumn Header="Day" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding PreferredDay}"/>
					<DataGridTextColumn Header="Length" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Duration}"/>
					<DataGridTemplateColumn Header="/">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button x:Name="CompleteButton"  Content="/"  Grid.Row="8" Grid.Column="2" PreviewMouseLeftButtonDown="CompleteButton_PreviewMouseLeftButtonDown" Click="CompleteButton_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>

        <!-- Fun Activities Tasks -->
		<Grid Margin="10,10,10,10" Grid.Column="3" Grid.Row="2">
			<DataGrid x:Name="AllFunActivities" Grid.Row="9" Grid.RowSpan="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="AllFunActivities_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="#" Width="10*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding TaskID}"/>
					<DataGridTextColumn Header="Name" Width ="60*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>
					<DataGridTextColumn Header="Day" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding PreferredDay}"/>
					<DataGridTextColumn Header="Length" Width=" 40*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Duration}"/>
					<DataGridTemplateColumn Header="/">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button x:Name="CompleteButton"  Content="/"  Grid.Row="8" Grid.Column="2" PreviewMouseLeftButtonDown="CompleteButton_PreviewMouseLeftButtonDown" Click="CompleteButton_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>

        <!-- Completed Goals -->
        <Grid Margin="10,10,10,10" Grid.Column="4" Grid.Row="2">
		<DataGrid x:Name="CompletedTasks" Grid.Row="9" Grid.RowSpan="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CompletedTask_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Task" Width ="100*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding TaskID}"/>
				<DataGridTextColumn Header="Completed" Width="80*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding CompletedAt}"/>
			</DataGrid.Columns>
		</DataGrid>
		</Grid>
	</Grid>
</Page>
