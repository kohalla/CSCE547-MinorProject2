<Page x:Class="TaskScheduler.AppointmentDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 

      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentDetailsPage"
      Background="{DynamicResource WindowBackgroundBrush}"
      Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid TextBox.TextChanged="OnTextboxTextChanged" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Content="Appointment Details" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Label Content="Appointment: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtAppointmentTitle" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,10,10,5" Grid.Row="1" Grid.Column="1"  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Label Content="Appointment Category: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox x:Name="cmbAppointmentCategory" Grid.Row="1" Grid.Column="3" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" Margin="10,10,10,5"/>
		
        <Label Content="Location: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtLocation" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,5,10,5" Grid.Row="2" Grid.Column="1"  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Label Content="Start: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="3" Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtStart" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,5,10,5" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource PrimaryTextBrush}"  Background="{DynamicResource SurfaceBrush}"/>
		
        <Label Content="End: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="3" Grid.Column="2" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtEnd" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,5,10,5" Grid.Row="3" Grid.Column="3" Foreground="{DynamicResource PrimaryTextBrush}"  Background="{DynamicResource SurfaceBrush}"/>
		
        <Label Content="Reminder: " FontSize="{DynamicResource SmallFontSize}"  Margin="0,0,0,0" Grid.Row="4" Grid.Column="2" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtReminder" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,5,10,5" Grid.Row="4" Grid.Column="3"  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Label Content="Notes: " FontSize="{DynamicResource BodyFontSize}" FontWeight="Bold" Margin="0,0,0,0" Grid.Row="4" Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}"/>
		<TextBox x:Name="txtNotes" IsReadOnly="False" FontSize="{DynamicResource SmallFontSize}"  Margin="10,5,10,5" Grid.Row="4" Grid.Column="1" Grid.RowSpan="4" TextWrapping="Wrap"  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

		<Button x:Name="DeleteButton"  Content="Delete"  Grid.Row="9" Grid.Column="0"  Click="DeleteButton_Click"/>
		
		<Button x:Name="SaveButton"  Content="Save" IsEnabled="False"  Grid.Row="9" Grid.Column="3"  Click="SaveButton_Click"/>


	</Grid>
</Page>
