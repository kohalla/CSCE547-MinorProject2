<Application x:Class="TaskScheduler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:local="clr-namespace:TaskScheduler"
             StartupUri="MainWindow.xaml">
	<Application.Resources>
		<!-- Design-time merged dictionary to allow the XAML designer to resolve brushes
			 without loading the runtime theme dictionaries. Keep this limited to simple
			 brushes to avoid duplicate implicit style keys. -->
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Themes/DesignTimeColors.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
