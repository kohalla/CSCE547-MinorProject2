<!--LightTheme.xaml (Mango Paradise — warm, bright, mango-accent)-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:conv="clr-namespace:TaskScheduler.Converters">
	<!-- Colors -->
	<Color x:Key="WindowBackgroundColor">#FFFDF8F2</Color>
	<Color x:Key="SurfaceColor">#FFFFFFFF</Color>
	<Color x:Key="PrimaryTextColor">#FF1E1E1E</Color>
	<Color x:Key="SecondaryTextColor">#FF6B6B6B</Color>
	<Color x:Key="AccentColor">#FFFF8C42</Color>
	<!-- Mango orange -->
	<Color x:Key="Accent2Color">#FF2AB7A9</Color>
	<!-- complementary teal -->
	<Color x:Key="SecondarySurfaceColor">#FFdfc4</Color>

	<!-- Font size tokens (will be updated at runtime for responsive scaling) -->
	<sys:Double x:Key="HeadingFontSize">24</sys:Double>
	<sys:Double x:Key="SubheadingFontSize">18</sys:Double>
	<sys:Double x:Key="BodyFontSize">14</sys:Double>
	<sys:Double x:Key="SmallFontSize">12</sys:Double>
	<!-- Calendar sizing tokens -->
	<sys:Double x:Key="CalendarWidth">320</sys:Double>
	<sys:Double x:Key="CalendarHeight">260</sys:Double>
	<sys:Double x:Key="CalendarDayCellSize">36</sys:Double>
	<sys:Double x:Key="CalendarDayCellPadding">4</sys:Double>
	<Color x:Key="BorderColor">#FFE6D9CF</Color>
	<Color x:Key="HoverColor">#FFFFEAD6</Color>
	<Color x:Key="SelectionColor">#FFFFD4B0</Color>
	<Color x:Key="DisabledColor">#FFBFBFBF</Color>
	<Color x:Key="ErrorColor">#FFD9534F</Color>
	<Color x:Key="SuccessColor">#FF4CAF50</Color>

	<!-- Header and navigation colors -->
	<Color x:Key="HeaderBackgroundColor">#FFF2C89A</Color> <!-- warm header for light theme -->
	<Color x:Key="HeaderForegroundColor">#FF1E1E1E</Color>

	<Color x:Key="NavBackgroundColor">#FFFFF8F0</Color> <!-- light nav bar -->
	<Color x:Key="NavForegroundColor">#FF1E1E1E</Color>
	<Color x:Key="NavButtonBackgroundColor">#FFFFFFFF</Color>
	<Color x:Key="NavButtonForegroundColor">#FF2B2B2B</Color>
	<Color x:Key="NavButtonBorderColor">#FFE6D9CF</Color>
	<!-- Brushes -->
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
	<SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
	<SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}"/>
	<SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>
	<SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
	<SolidColorBrush x:Key="Accent2Brush" Color="{DynamicResource Accent2Color}"/>
	<SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
	<SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
	<SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}"/>
	<SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}"/>
	<SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
	<SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>

	<!-- Brushes for headers and navigation -->
	<SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackgroundColor}"/>
	<SolidColorBrush x:Key="HeaderForegroundBrush" Color="{DynamicResource HeaderForegroundColor}"/>
	<SolidColorBrush x:Key="NavBackgroundBrush" Color="{DynamicResource NavBackgroundColor}"/>
	<SolidColorBrush x:Key="NavForegroundBrush" Color="{DynamicResource NavForegroundColor}"/>
	<SolidColorBrush x:Key="NavButtonBackgroundBrush" Color="{DynamicResource NavButtonBackgroundColor}"/>
	<SolidColorBrush x:Key="NavButtonForegroundBrush" Color="{DynamicResource NavButtonForegroundColor}"/>
	<SolidColorBrush x:Key="NavButtonBorderBrush" Color="{DynamicResource NavButtonBorderColor}"/>

	<!-- ComboBox background gradient based on surface/window colors -->
	<SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="{DynamicResource SurfaceColor}" />

	<!-- DataGrid styling to match dark theme equivalents but for light theme -->
	<Style x:Key="DataGridWrapCellsStyle" TargetType="DataGrid">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="RowBackground" Value="Transparent"/>
		<Setter Property="AlternatingRowBackground" Value="{DynamicResource WindowBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="GridLinesVisibility" Value="None"/>
		<Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
		<!-- Allow rows to autosize for wrapped content -->
		<Setter Property="RowHeight" Value="{x:Static sys:Double.NaN}"/>
		<Setter Property="CellStyle">
			<Setter.Value>
				<Style TargetType="DataGridCell">
					<Setter Property="Padding" Value="4"/>
					<Style.Resources>
						<!-- implicit TextBlock style used by DataGridTextColumn element -->
						<Style TargetType="TextBlock">
							<Setter Property="TextWrapping" Value="Wrap"/>
						</Style>
						<!-- implicit TextBox style for editing -->
						<Style TargetType="TextBox">
							<Setter Property="TextWrapping" Value="Wrap"/>
							<Setter Property="AcceptsReturn" Value="True"/>
						</Style>
					</Style.Resources>
				</Style>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Global control defaults -->
	<!-- Labels: remove background and center content -->
	<Style TargetType="Label">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	

	<!-- ComboBoxes: center text and use a secondary surface background -->
	<!-- Ensure a SecondaryBrush exists for light theme -->
	<SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SurfaceColor}" />
	<ControlTemplate x:Key="ComboBoxControlTemplate" TargetType="ComboBox">
		<Grid>
			<Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="2">
				<Grid>
					<ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0,25,0">
						<ContentPresenter.Content>
							<MultiBinding Converter="{x:Static conv:ComboBoxSelectionTextConverter.Instance}">
								<Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" />
								<Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" />
							</MultiBinding>
						</ContentPresenter.Content>
					</ContentPresenter>
					<ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" HorizontalAlignment="Right" Width="20" Margin="0">
						<Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</ToggleButton>
				</Grid>
			</Border>
			<Popup x:Name="Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
				<Border Background="#FFFFFFFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
					<ScrollViewer Margin="0" CanContentScroll="True">
						<ItemsPresenter />
					</ScrollViewer>
				</Border>
			</Popup>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="HasItems" Value="false">
				<Setter TargetName="Popup" Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="false">
				<Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style TargetType="ComboBox">
		<Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template" Value="{StaticResource ComboBoxControlTemplate}" />
	</Style>
	<Style TargetType="ComboBoxItem">
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style TargetType="DataGridRow">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Calendar basic styling -->
	<Style TargetType="Calendar">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Padding" Value="8"/>

	</Style>
	<Style TargetType="CalendarButton">
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style TargetType="CalendarDayButton">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
		<Setter Property="Padding" Value="{DynamicResource CalendarDayCellPadding}"/>
		<Setter Property="Width" Value="{DynamicResource CalendarDayCellSize}"/>
		<Setter Property="Height" Value="{DynamicResource CalendarDayCellSize}"/>
		<Setter Property="MinWidth" Value="{DynamicResource CalendarDayCellSize}"/>
		<Setter Property="MinHeight" Value="{DynamicResource CalendarDayCellSize}"/>
		<Style.Triggers>
			<Trigger Property="IsInactive" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
				<Setter Property="Opacity" Value="0.9"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- DataGrid column header styling (converted to explicit keyed style to avoid implicit key collisions) -->
	<Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Padding" Value="6,4"/>
		<Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="BorderThickness" Value="0,0,0,1"/>
	</Style>

	<!-- DataGrid column header styling -->
	<Style TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
		<Setter Property="Padding" Value="6,4"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="BorderThickness" Value="0,0,0,1"/>
	</Style>

	<!-- Navigation (Menu) styling -->
	<Style TargetType="Menu">
		<Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}"/>
	</Style>

	<Style TargetType="MenuItem">
		<Setter Property="Background" Value="{DynamicResource NavButtonBackgroundBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource NavButtonForegroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource NavButtonBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="8,4"/>
		<Setter Property="Margin" Value="2,0,2,0"/>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource NavButtonForegroundBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- Basic styles -->
	<Style TargetType="Window">
		<Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="Button">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Padding" Value="8,4"/>
		<Setter Property="Margin" Value="4"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
