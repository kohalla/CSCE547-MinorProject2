<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!-- Design-time-only brushes so the XAML designer can resolve DynamicResource keys
		 Loaded at parse time via App.xaml merged dictionary. Keep this limited to simple
		 brushes to avoid duplicate implicit style key collisions. -->

	<SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF000000"/>
	<SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6B6B6B"/>
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF0F0F0"/>
	<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="AccentBrush" Color="#FF0078D7"/>

	<!-- Basic font size tokens for design-time rendering -->
	<sys:Double x:Key="HeadingFontSize">24</sys:Double>
	<sys:Double x:Key="SubheadingFontSize">18</sys:Double>
	<sys:Double x:Key="BodyFontSize">14</sys:Double>
	<sys:Double x:Key="SmallFontSize">12</sys:Double>

</ResourceDictionary>