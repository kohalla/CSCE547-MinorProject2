<Page x:Class="TaskScheduler.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentPage"
      Background="{DynamicResource WindowBackgroundBrush}"
      Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="22*" />
        </Grid.RowDefinitions>

        <!-- Page Header-->
        <Label Content="Appointments" Grid.Column="0" Grid.Row="0" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Medium" Grid.ColumnSpan="2" Margin="0,0,0,40" Grid.RowSpan="2" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button Content="Add Appointment+" Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="{DynamicResource SmallFontSize}" Click="Click_AddAppointment" />
        
        <!-- labels -->
        <Label Content="Upcoming" Grid.Column="0" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        <!--Label Content="Appointments" Grid.Column="2" Grid.Row="1" FontSize="18" FontWeight="Bold" /-->
        <Label Content="Past" Grid.Column="2" Grid.Row="1" FontSize="{DynamicResource SubheadingFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />

        <!-- Upcoming Appointment content-->
        <Grid Margin="0,0,0,0" Grid.Column="0" Grid.Row="2">
			<DataGrid x:Name="UpcomingAppointments" Grid.Row="1" Margin="10,10,10,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="UpcomingAppointments_SelectionChanged" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width ="110*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Start Date" Width=" 65*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding StartDateTime}"/>
                    <DataGridTextColumn Header="End Date" Width=" 65*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding EndDateTime}"/>
				</DataGrid.Columns>
			</DataGrid>

		</Grid>
        <!-- Appointments content-->
        <Viewbox Grid.Column="1" Grid.Row="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" Stretch="Uniform">
            <Calendar x:Name="AppointmentsCalendar" />
        </Viewbox>


        <!-- Past Appointment content-->
        <Grid Margin="0,0,0,0" Grid.Column="2" Grid.Row="2">
            <DataGrid x:Name="PastAppointments" Grid.Row="1" Margin="10,10,10,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="PastAppointments_SelectionChanged" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
				<DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width ="110*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Start Date" Width=" 65*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding StartDateTime}"/>
                    <DataGridTextColumn Header="End Date" Width=" 65*" FontSize="{DynamicResource SmallFontSize}" Binding="{Binding EndDateTime}"/>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
    </Grid>
</Page>
