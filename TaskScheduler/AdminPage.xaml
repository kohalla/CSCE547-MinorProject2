<Page x:Class="TaskScheduler.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskScheduler"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage"
      Background="{DynamicResource WindowBackgroundBrush}"
      Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="5*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Content="Categories" Foreground="{DynamicResource PrimaryTextBrush}"  FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"/>
		<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" >
			<ComboBox x:Name="searchCategoryComboBox"/>
			<TextBox x:Name="searchCategoryTextBox" Width="200" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<Button x:Name="searchCategoryButton" Content="Search" Width="75" Margin="10,0,0,0" Click="Click_SearchCategoryGo"/>
			<Button x:Name="clearSearchButton" Content="X" Margin="10,0,0,0" Click="Click_ClearSearch"/>
		</StackPanel>
		<Button Content="Add Category+" Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="{DynamicResource SmallFontSize}" Click="Click_AddCategory"/>
		<DataGrid x:Name="categoryDataGrid" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="True" AutoGeneratingColumn="CategoryDataGrid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Category_SelectionChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ColumnWidth="*"/>


	</Grid>
</Page>
